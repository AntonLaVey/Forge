<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!-- Replace with the target game's bundle identifier so MobileSubstrate
		     only injects SeedCatcher into that process. -->
		<key>Bundles</key>
		<array>
			<string>com.example.REPLACE_WITH_GAME_BUNDLE_ID</string>
		</array>
	</dict>
</dict>
</plist>
